{
  "expo": {
    "name": "Picross: Cryptozoology",
    "slug": "cryptid-picross",
    "scheme": "picrosscrypto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1E8D3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.picrosscryptozoology",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.picrosscryptozoology",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F1E8D3"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "We use your data to show more relevant ads. You can decline and still see ads."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "We use your data to show more relevant ads. You can decline and still see ads."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenueCat": {
        "iosApiKey": "",
        "androidApiKey": ""
      },
      "admob": {
        "iosInterstitialAdUnitId": "",
        "androidInterstitialAdUnitId": ""
      },
      "router": {},
      "eas": {
        "projectId": "cd62e744-d6aa-454e-ae24-67d4ba0af97b"
      }
    },
    "owner": "codemack-dev"
  }
}
