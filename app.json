{
  "expo": {
    "name": "Picross: Cryptozoology",
    "slug": "cryptid-picross",
    "scheme": "picrosscrypto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1E8D3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.picrosscryptozoology",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.picrosscryptozoology",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F1E8D3"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenueCat": {
        "iosApiKey": "appl_RSatTAWNpxHgDqgpRkxUOquSibF",
        "androidApiKey": ""
      },
      "router": {},
      "eas": {
        "projectId": "cd62e744-d6aa-454e-ae24-67d4ba0af97b"
      }
    },
    "owner": "codemack-dev"
  }
}
