# Expo SDK 57 pulls react-dom (via expo-router web deps) at a patch that peer-
# requires a newer react than the RN-pinned react. The mismatch is harmless for
# a mobile-only app (react-dom is unused) but makes strict peer resolution fail.
# legacy-peer-deps keeps `npm install`/`npm ci` reproducible without downgrading
# real dependencies. Standard for Expo projects.
legacy-peer-deps=true
